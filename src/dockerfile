# syntax=docker/dockerfile:1

ARG BASE_IMAGE=ghcr.io/offloadr/base/cpu-core:py3.13-torch2.14.1-cpu

# The archive is a build input, separate from the published runtime layers.
FROM ${BASE_IMAGE} AS forge-source
ARG REFRESH_FORGE_NEO=0
RUN echo "${REFRESH_FORGE_NEO}" >/tmp/forge-neo-refresh
ARG FORGE_NEO_VERSION=neo
ADD https://github.com/Haoming02/sd-webui-forge-classic/archive/${FORGE_NEO_VERSION}.tar.gz /tmp/forge-neo.tar.gz
RUN mkdir -p /sd-webui-forge-neo && \
    tar -xzf /tmp/forge-neo.tar.gz -C /sd-webui-forge-neo --strip-components=1 && \
    rm /tmp/forge-neo.tar.gz

FROM ${BASE_IMAGE} AS runtime-files
COPY --chmod=755 runtime-venv.sh entrypoint.sh warmup.sh /runtime/
RUN sed -i 's/\r$//' /runtime/*

FROM ${BASE_IMAGE} AS forge-assets
COPY --from=forge-source /sd-webui-forge-neo/backend/huggingface/ /sd-webui-forge-neo/backend/huggingface/
RUN PYTHONDONTWRITEBYTECODE=1 "${OFFLOADR_VENV}/bin/python" -c \
    'import runpy; runpy.run_path("/sd-webui-forge-neo/backend/huggingface/__init__.py")["process"]()'

FROM ${BASE_IMAGE} AS forge-dependencies
WORKDIR /sd-webui-forge-neo

# Runtime tools and shared libraries used by Forge Neo and its preprocessors.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg git libcairo2-dev libgl1 libglib2.0-0 pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Only dependency inputs cross from the upstream source stage. COPY compares
# their contents, so source-only changes reuse the installed venv layer.
COPY --from=forge-source /sd-webui-forge-neo/requirements.txt requirements.txt
COPY --from=forge-source /sd-webui-forge-neo/extensions-builtin/forge_legacy_preprocessors/requirements.txt extensions-builtin/forge_legacy_preprocessors/requirements.txt
COPY requirements.extra.txt /opt/offloadr/forge-requirements.extra.txt
ARG DEPTH_ANYTHING_WHEEL=https://github.com/huchenlei/Depth-Anything/releases/download/v1.0.0/depth_anything-2024.1.22.0-py2.py3-none-any.whl
ARG DEPTH_ANYTHING_V2_WHEEL=https://github.com/MackinationsAi/UDAV2-ControlNet/releases/download/v1.0.0/depth_anything_v2-2024.7.1.0-py2.py3-none-any.whl
# Forge's Pillow pin exceeds Gradio's declared upper bound. Apply the launcher
# dependencies first, then Forge's requirements within the same image layer.
RUN --mount=type=cache,id=forge-neo-uv-build,target=/root/.cache/uv-build,sharing=locked \
    test -n "${OFFLOADR_VENV}" && \
    test -x "${OFFLOADR_VENV}/bin/python" && \
    UV_CACHE_DIR=/root/.cache/uv-build uv pip install \
        --python "${OFFLOADR_VENV}/bin/python" \
        packaging==26.2 gradio==4.40.0 gradio_rangeslider==0.0.8 && \
    UV_CACHE_DIR=/root/.cache/uv-build uv pip install \
        --python "${OFFLOADR_VENV}/bin/python" \
        -r requirements.txt \
        -r extensions-builtin/forge_legacy_preprocessors/requirements.txt \
        -r /opt/offloadr/forge-requirements.extra.txt \
        "${DEPTH_ANYTHING_WHEEL}" "${DEPTH_ANYTHING_V2_WHEEL}"

# Bundled tokenizers are much larger than the application code and have their
# own content-based cache, independent of changes elsewhere in the source tree.
COPY --link --from=forge-assets /sd-webui-forge-neo/backend/huggingface/ /sd-webui-forge-neo/backend/huggingface/

EXPOSE 7860
ENV PYTHONUNBUFFERED=1
ENV GRADIO_ANALYTICS_ENABLED=False
ENV XFORMERS_IGNORE_FLASH_VERSION_CHECK=1
COPY --link --from=runtime-files /runtime/runtime-venv.sh /runtime/entrypoint.sh /sd-webui-forge-neo/
ENTRYPOINT ["./entrypoint.sh"]

# Preserve first-startup artifacts while making venv changes impossible. All
# installation happens in forge-dependencies; warmup only prepares the app tree.
FROM forge-dependencies AS forge-prepared
COPY --link --from=forge-source --exclude=backend/huggingface /sd-webui-forge-neo/ /sd-webui-forge-neo/
RUN --mount=type=bind,from=forge-dependencies,source=/opt/venv,target=/opt/venv \
    --mount=type=bind,from=forge-dependencies,source=/sd-webui-forge-neo/backend/huggingface,target=/sd-webui-forge-neo/backend/huggingface \
    --mount=type=bind,from=runtime-files,source=/runtime/warmup.sh,target=/tmp/forge-warmup.sh \
    PYTHONDONTWRITEBYTECODE=1 UV_CACHE_DIR=/tmp/forge-uv-cache sh /tmp/forge-warmup.sh

# Application source and generated startup artifacts form the final layer.
FROM forge-dependencies AS sd-webui-forge-neo
COPY --link --from=forge-prepared \
    --exclude=requirements.txt \
    --exclude=extensions-builtin/forge_legacy_preprocessors/requirements.txt \
    --exclude=backend/huggingface \
    --exclude=runtime-venv.sh --exclude=entrypoint.sh \
    /sd-webui-forge-neo/ /sd-webui-forge-neo/
